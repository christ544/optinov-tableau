# Variables d'environnement du tableau de bord OPTINOV (agence de communication).
# Copier ce fichier en `.env` pour le développement local, et **sur le serveur
# PlanetHoster** (`cp .env.example .env && nano .env`, voir le guide de
# déploiement). Sur Render, les valeurs se renseignent dans l'interface.
# Dans tous les cas : ne jamais commiter les vraies valeurs.

# Base de données PostgreSQL.
#   Local : un rôle et une base dédiés (voir README, « Installation locale »).
#   Render : la chaîne de connexion Neon, avec ?sslmode=require
#   PlanetHoster : la base créée dans le panneau N0C, menu « Bases de données ».
DATABASE_URI=postgresql://optinov_tableau:optinov_tableau_dev@localhost:5432/optinov_tableau

# Secret de signature des sessions (Render le génère automatiquement).
# En local et sur PlanetHoster : openssl rand -hex 32
# Le changer déconnecte tout le monde — le garder stable une fois posé.
PAYLOAD_SECRET=

# Adresse publique de CE tableau de bord (CSRF, liens des e-mails).
#   Local : laisser vide -> http://localhost:3000
#   Render : laisser vide -> RENDER_EXTERNAL_URL est fournie automatiquement.
#   PlanetHoster : OBLIGATOIRE, et **exactement** l'adresse par laquelle on ouvre
#   l'admin (https://admin.optinov.ci). Rien ne la fournit automatiquement, et
#   une valeur qui ne correspond pas donne un tableau de bord consultable où tout
#   enregistrement est refusé.
PAYLOAD_PUBLIC_SERVER_URL=

# Adresse du site vitrine (CORS, lien « Voir le site en ligne »).
# Laisser vide -> l'adresse actuelle du site sur Cloudflare.
FRONTEND_URL=

# Origines supplémentaires autorisées à écrire, séparées par des virgules
# (utile le temps d'un changement de nom de domaine). Vide en général.
ORIGINES_AUTORISEES=

# Cloudinary, stockage des images en production.
# Laisser VIDE en local : les images s'écrivent alors sur le disque, dans ./media
# Sur PlanetHoster, garder Cloudinary est le plus simple : sinon les images vivent
# dans ./media, un dossier du serveur qu'il faut sauvegarder soi-même (voir le
# guide de déploiement, « Les images »).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reconstruction du site vitrine après chaque modification de contenu
# (URL du « Deploy Hook » Cloudflare Pages). Laisser VIDE en local.
SITE_DEPLOY_HOOK=

# E-mails : alerte à l'agence à chaque demande, accusé de réception au prospect,
# « mot de passe oublié ». Avec le Gmail de l'agence : SMTP_USER = l'adresse Gmail,
# SMTP_PASS = un « mot de passe d'application » (compte Google > Sécurité >
# Validation en deux étapes > Mots de passe des applications), JAMAIS le mot de
# passe du compte. Laisser SMTP_HOST vide en local : les e-mails s'affichent en console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Adresse qui reçoit les alertes de nouvelles demandes (peut être la même que SMTP_USER).
ALERTES_EMAIL=
