# Variables d'environnement du tableau de bord OPTINOV.
# (Sur Render, elles se renseignent dans l'interface — ne pas commiter les vraies valeurs.)

# Base de données MongoDB Atlas (gratuit)
# ex : mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/optinov
DATABASE_URI=

# Secret de sécurité Payload (généré automatiquement par Render)
PAYLOAD_SECRET=

# Cloudinary — stockage des images (gratuit)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
